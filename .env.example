# Database & Auth Configuration (e.g., Supabase / Firebase)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Canonical production origin (no trailing slash), e.g. https://websitepro-seven.vercel.app
# Used for sitemap.xml, robots.txt, canonical URLs, and Open Graph/Twitter tags.
# Update this single value when the site migrates to a custom domain.
VITE_SITE_URL=

# Google Service Account for Google Drive Streaming
# Paste the entire JSON file content here as a single string (can be base64 encoded if preferred, or raw JSON)
GOOGLE_SERVICE_ACCOUNT_JSON=

# Token Secret for Video Streaming Authorization
STREAMING_TOKEN_SECRET=

# Optional video API base. Leave blank to use the existing same-origin Vercel
# routes; set to the deployed Cloudflare Worker URL after migration testing.
VITE_API_BASE_URL=

# Optional: enables automatic duration lookup for YouTube lessons.
YOUTUBE_DATA_API_KEY=

# Sentry DSN for client-side error monitoring. Leave blank locally — when
# unset, Sentry is never initialized and no events are sent.
VITE_SENTRY_DSN=

# GA4 Measurement ID for product analytics. Only loaded in production builds
# and only when set — leave blank locally, nothing is sent in development.
VITE_GA_MEASUREMENT_ID=

# Resend API key for sending the contact-form confirmation email. Leave
# blank to store contact submissions without sending a confirmation — the
# failure is logged and the submission is marked email_failed, but the
# visitor still sees success since their message was stored.
RESEND_API_KEY=

# Optional: overrides the default "Tutiba Support <support@tutiba.com>"
# From address for contact-form confirmation emails. Must be a domain
# verified with Resend.
CONTACT_EMAIL_FROM=
