{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": "^22.17.0 || >=24.0.0"
  },
  "scripts": {
    "dev": "tsx server.ts",
    "postinstall": "node scripts/postinstall.mjs",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs && tsx scripts/prerender.mjs",
    "postbuild": "tsx scripts/generate-seo-files.mjs",
    "build:check": "npm run build && node scripts/check-bundle-budget.mjs",
    "start": "node dist/server.cjs",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js dist/server.cjs",
    "lint": "tsc --noEmit",
    "test": "tsx --test src/server/**/*.test.ts src/domain/**/*.test.ts src/lib/**/*.test.ts",
    "test:frontend": "tsx --test src/test/*.frontend.test.tsx",
    "test:browser-smoke": "npm run build && node --test tests/browser/*.test.mjs",
    "test:quality": "node scripts/quality-audit.mjs",
    "test:course-authoring-release": "node scripts/verify-course-authoring-release.mjs",
    "build:database-rollout": "node scripts/build-database-rollout.mjs",
    "test:course-authoring-production": "node scripts/verify-course-authoring-production.mjs"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@google/genai": "^2.4.0",
    "@sentry/react": "^10.69.0",
    "@supabase/supabase-js": "^2.110.8",
    "@tailwindcss/vite": "^4.1.14",
    "@tiptap/extension-image": "^2.27.2",
    "@tiptap/extension-link": "^2.27.2",
    "@tiptap/extension-placeholder": "^2.27.2",
    "@tiptap/extension-table": "^2.27.2",
    "@tiptap/extension-table-cell": "^2.27.2",
    "@tiptap/extension-table-header": "^2.27.2",
    "@tiptap/extension-table-row": "^2.27.2",
    "@tiptap/pm": "^2.27.2",
    "@tiptap/react": "^2.27.2",
    "@tiptap/starter-kit": "^2.27.2",
    "@vidstack/react": "^1.12.3",
    "@vitejs/plugin-react": "^5.0.4",
    "dompurify": "^3.4.13",
    "express": "^4.21.2",
    "googleapis": "^173.0.0",
    "hls.js": "^1.6.16",
    "jsonwebtoken": "^9.0.3",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "node-fetch": "^3.3.2",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-router-dom": "^7.18.1",
    "vite": "^6.2.3"
  },
  "devDependencies": {
    "@sparticuz/chromium": "^149.0.0",
    "@types/dompurify": "^3.0.5",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.14.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.1",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "playwright": "^1.62.1",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3"
  }
}
